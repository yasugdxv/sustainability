{
  "azure": {
    "endpoint":           "https://YOUR-RESOURCE.openai.azure.com/",
    "api_key":            "ここにAzure OpenAIのAPIキー",
    "default_deployment": "gpt-4o",
    "api_version":        "2024-05-01-preview"
  },
  "api_keys": {
    "openai": "sk-proj-ここにOpenAI APIキーを入力（azureがあれば不要）",
    "marinetraffic": "ここにMarineTraffic APIキーを入力（船舶追跡に必要・marinetraffic.com で無料登録）",
    "regulations_gov": "ここにRegulations.gov APIキーを入力（open.gsa.gov で無料登録）"
  },
  "proxy": {
    "enabled": true,
    "http_proxy": "http://jejp1prfp001.sgn.suntory.co.jp:9400"
  },
  "ssl": {
    "verify": false
  },
  "supabase": {
    "url": "https://xxxx.supabase.co",
    "key": "ここに anon public API key を入力",
    "service_role_key": "ここに service_role key を入力（article_crawler.py / article_analyzer.py / sustainability_*.py で必要）"
  },
  "sustainability_expert": {
    "enabled": true,
    "expert_version": "0.1.0",
    "knowledge_search": {
      "mode": "local",
      "azure_ai_search": {
        "endpoint": "https://YOUR-SEARCH-SERVICE.search.windows.net",
        "api_key": "ここにAzure AI SearchのAPIキーを入力（modeがazure_ai_searchの場合のみ必要）",
        "index_name": "suntory-sustainability-expert-v1"
      },
      "embedding_deployment": "（任意。ベクトル検索を使う場合のみAzure OpenAIのembeddingデプロイ名を入力）"
    }
  },
  "geo_intelligence": {
    "enabled": false,
    "base_url": "https://YOUR-GEO-INTELLIGENCE-APP/",
    "query_path": "/api/v1/geo-intelligence/query",
    "timeout_seconds": 20,
    "api_key": "ここにGeo Intelligence APIのAPIキーを入力（X-API-Keyヘッダーで送信。現時点はAPIキー方式）",
    "max_retries": 2,
    "weekly_monitoring": {
      "enabled": false,
      "scope_version": "v1",
      "max_independent_topics": 3,
      "dedup_candidate_pool_max": 200
    },
    "chat": {
      "enabled": false,
      "reuse_enabled": true,
      "reuse_max_age_hours": 24,
      "reuse_max_age_hours_high_freshness": 2
    },
    "search": {
      "enabled": false
    }
  },
  "weekly_digest": {
    "since_days": 7,
    "target_min": 15,
    "target_max": 20
  },
  "competitor_monitoring": {
    "enabled": true,
    "auto_send_confidence_threshold": 0.85
  },
  "monthly_competitor_digest": {
    "since_days": 30
  },
  "strategic_question": {
    "enabled": false,
    "since_days_signals": 14,
    "since_days_competitor": 14,
    "response_window_days": 5,
    "duplicate_lookback_weeks": 10,
    "min_responses_for_publish": 10,
    "min_response_rate_for_publish": 0.15,
    "chat_max_age_days": 180,
    "chat_max_items": 3,
    "hmac_secret": "ここにランダムな秘密文字列を生成して入力（recipient_key/response tokenの導出に使う。他のAPIキーと同様、絶対に外部出力・コミットしないこと。例: python -c \"import secrets; print(secrets.token_urlsafe(32))\"）",
    "app_base_url": "https://YOUR-PRODUCTION-HOST/（社員がメールのリンクをクリックしてアクセスできる本番ホスト名。127.0.0.1では社外/他端末から届かないため本番化時に必須）"
  },
  "email": {
    "enabled": false,
    "smtp_host": "（例: 社内SMTPリレーのホスト名、またはsmtp.office365.com）",
    "smtp_port": 587,
    "use_starttls": true,
    "smtp_user": "（認証が必要な場合のみ）",
    "smtp_password": "（認証が必要な場合のみ）",
    "from_address": "sustainability-report@example.com"
  }
}

